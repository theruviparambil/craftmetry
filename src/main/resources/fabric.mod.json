{
  "schemaVersion": 1,
  "id": "craftmetry",
  "version": "${version}",
  "name": "Craftmetry",
  "description": "A lightweight client-side clicks-per-second HUD.",
  "authors": [
    "Alexander Theruviparambil"
  ],
  "contact": {
    "sources": "https://github.com/theruviparambil/craftmetry"
  },
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.theruviparambil.craftmetry.CraftmetryClient"
    ]
  },
  "mixins": [
    {
      "config": "craftmetry.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.157.0+26.2"
  }
}
